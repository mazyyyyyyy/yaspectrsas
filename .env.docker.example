# ─── Скопировать в .env рядом с docker-compose.yml: cp .env.docker.example .env
# ─── Значения ниже рабочие «из коробки». Пароль БД и SESSION_SECRET
#     желательно заменить на свои перед боевым использованием.

# ─── PostgreSQL ───
POSTGRES_USER=yaspectr
POSTGRES_PASSWORD=change_me_0S1UPLdCnTxvsl1
POSTGRES_DB=yaspectr

# ─── Сессии ───
# Секрет подписи cookie. Сгенерировать свой:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=gpb3CfA6EZ5aMHUF7kXsI8qHvPgs2woTonT7XnulIPpZsSZGuMXXjAnLNdOTgyiy
SESSION_TTL_MINUTES=720

# ─── Доступ фронта ───
# Адрес, по которому открываете приложение. Замените localhost на IP/имя
# вашего Synology, напр. http://192.168.1.50:8324
CORS_ORIGINS=http://localhost:8324

# ─── Telegram (необязательно, отправка актов) ───
# Пусто = интеграция выключена, API стартует без неё.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
