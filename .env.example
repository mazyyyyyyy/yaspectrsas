# ─── Скопировать в .env и заполнить. .env в git не попадает. ───

NODE_ENV=development

# ─── База данных ───
POSTGRES_USER=yaspectr
POSTGRES_PASSWORD=change_me_to_a_long_random_string
POSTGRES_DB=yaspectr
DATABASE_URL=postgresql://yaspectr:change_me_to_a_long_random_string@localhost:5432/yaspectr?schema=public

# ─── API ───
API_PORT=3000
# Домены фронта, которым разрешён доступ. Через запятую, без слеша на конце.
# ВАЖНО: никаких «*» — cookie-сессии этого не допускают.
CORS_ORIGINS=http://localhost:5173

# Секрет для подписи cookie сессии. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Время жизни сессии, минут (скользящее продление при активности)
SESSION_TTL_MINUTES=720

# true на проде за HTTPS — cookie получит флаг Secure
COOKIE_SECURE=false
# Домен cookie на проде, напр. .yaspectr.ru. Пусто в разработке.
COOKIE_DOMAIN=

# ─── Telegram (отправка актов) ───
# Токен от @BotFather. Пусто = интеграция выключена, API стартует без неё.
TELEGRAM_BOT_TOKEN=
# Секрет для проверки подлинности вебхука Telegram (любая случайная строка)
TELEGRAM_WEBHOOK_SECRET=

# ─── Экспорт документов ───
# Путь к Chrome/Chromium для генерации PDF. Пусто = puppeteer возьмёт свой.
CHROMIUM_PATH=

# ─── Фронт (apps/web) ───
VITE_API_URL=http://localhost:3000
