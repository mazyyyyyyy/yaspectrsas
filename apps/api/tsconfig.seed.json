{
  // Отдельная проверка типов для скриптов из prisma/ (seed и подобные).
  // Они не попадают в сборку API, но проверять их типы всё равно нужно:
  // seed падает уже на боевой базе, и лучше поймать ошибку раньше.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true
  },
  "include": ["prisma/**/*.ts"]
}
